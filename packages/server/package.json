    "socket.io": "4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.9.0",
    "socket.io-client": "4.8.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
